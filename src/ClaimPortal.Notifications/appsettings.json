{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MassTransit": "Information"
    }
  },

  "Messaging": {
    "Transport": "RabbitMq",
    "ClaimSubmittedQueueName": "claim-submitted-notifications",
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "guest",
      "Password": "guest"
    },
    "Resilience": {
      "ConcurrentMessageLimit": 1,
      "RetryLimit": 5,
      "MinRetryInterval": "00:00:01",
      "MaxRetryInterval": "00:00:30",
      "RetryIntervalDelta": "00:00:02",
      "RedeliveryIntervals": [ "00:05:00", "00:15:00", "01:00:00" ]
    }
  },

  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "SecureSocketOptions": "None",
    "FromAddress": "claims@redrivermutual.example",
    "FromDisplayName": "Red River Mutual Claims",
    "TimeoutSeconds": 30
  },

  "NotificationContent": {
    "InsurerDisplayName": "Red River Mutual",
    "SupportPhone": "1-800-370-2888",
    "SupportEmail": "claims@redrivermutual.example",
    "DisplayTimeZone": "America/Winnipeg"
  },

  "Idempotency": {
    "StaleClaimAfter": "00:05:00",
    "MaxClaimAttempts": 3
  },

  "Database": {
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:10",
    "MigrateOnStartup": true
  }
}
