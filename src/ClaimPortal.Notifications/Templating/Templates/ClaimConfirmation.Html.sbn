{{##
  Every interpolation of customer-supplied data goes through html.escape. Names arrive from
  a public form, so this template treats them as hostile text. ClaimConfirmationRendererTests
  asserts the escaping, so deleting a filter here fails the build.
##}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ InsurerDisplayName | html.escape }} claim {{ ClaimNumber | html.escape }} received</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
  <!-- Preheader: the grey snippet mail clients show next to the subject line. -->
  <div style="display:none;max-height:0;overflow:hidden;">Your claim number is {{ ClaimNumber | html.escape }}.</div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f4f5f7;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #e4e7eb;">

          <tr>
            <td style="background-color:#0b4f6c;padding:20px 28px;">
              <span style="font-size:18px;font-weight:600;color:#ffffff;">{{ InsurerDisplayName | html.escape }}</span>
            </td>
          </tr>

          <tr>
            <td style="padding:28px 28px 8px 28px;">
              <h1 style="margin:0 0 12px 0;font-size:22px;line-height:1.3;color:#102a43;">We have received your claim</h1>
              <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;">
                Hello {{ FirstName | html.escape }}, thank you for submitting your claim. Please keep the
                claim number below for your records and quote it whenever you contact us about this loss.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0f4f8;border-radius:6px;padding:16px 18px;">
                <tr>
                  <td style="font-size:12px;letter-spacing:0.06em;text-transform:uppercase;color:#52606d;padding-bottom:4px;">Claim number</td>
                </tr>
                <tr>
                  <td style="font-size:24px;font-weight:700;font-family:'SFMono-Regular',Consolas,'Liberation Mono',Menlo,monospace;color:#0b4f6c;letter-spacing:0.04em;">{{ ClaimNumber | html.escape }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:20px 28px 4px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="font-size:14px;line-height:1.6;">
                <tr>
                  <td style="color:#52606d;padding:6px 12px 6px 0;white-space:nowrap;">Policy number</td>
                  <td style="font-weight:600;padding:6px 0;">{{ PolicyNumber | html.escape }}</td>
                </tr>
                <tr>
                  <td style="color:#52606d;padding:6px 12px 6px 0;white-space:nowrap;">Type of loss</td>
                  <td style="font-weight:600;padding:6px 0;">{{ LossTypeLabel | html.escape }}</td>
                </tr>
                <tr>
                  <td style="color:#52606d;padding:6px 12px 6px 0;white-space:nowrap;">Date of loss</td>
                  <td style="font-weight:600;padding:6px 0;">{{ IncidentDate | html.escape }}</td>
                </tr>
                <tr>
                  <td style="color:#52606d;padding:6px 12px 6px 0;white-space:nowrap;">Submitted</td>
                  <td style="font-weight:600;padding:6px 0;">{{ SubmittedAt | html.escape }}</td>
                </tr>
                <tr>
                  <td style="color:#52606d;padding:6px 12px 6px 0;white-space:nowrap;">Policyholder</td>
                  <td style="font-weight:600;padding:6px 0;">{{ FullName | html.escape }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:20px 28px 0 28px;">
              <h2 style="margin:0 0 8px 0;font-size:16px;color:#102a43;">What happens next</h2>
              <p style="margin:0 0 16px 0;font-size:15px;line-height:1.6;">
                A claims representative will review your submission and contact you within one business day.
                If your property is unsafe or the damage is getting worse, please call us now rather than
                waiting for that call.
              </p>
              <p style="margin:0 0 20px 0;font-size:15px;line-height:1.6;">
                <strong>Phone</strong> <a href="tel:{{ SupportPhone | html.escape }}" style="color:#0b4f6c;">{{ SupportPhone | html.escape }}</a><br>
                <strong>Email</strong> <a href="mailto:{{ SupportEmail | html.escape }}" style="color:#0b4f6c;">{{ SupportEmail | html.escape }}</a>
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 28px 28px;">
              <p style="margin:0;padding-top:16px;border-top:1px solid #e4e7eb;font-size:12px;line-height:1.6;color:#7b8794;">
                This is an automated confirmation that your claim was received. It is not an assessment of
                coverage, and it is not an approval or denial of your claim.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
