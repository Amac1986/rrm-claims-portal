{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "MassTransit": "Information"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Claims": "Host=localhost;Port=5432;Database=claimportal;Username=claimportal;Password=claimportal"
  },

  "Database": {
    "MigrateOnStartup": true,
    "MaxRetryCount": 5,
    "MaxRetryDelay": "00:00:10"
  },

  "Messaging": {
    "Transport": "RabbitMq",
    "RabbitMq": {
      "Host": "localhost",
      "Port": 5672,
      "VirtualHost": "/",
      "UserName": "guest",
      "Password": "guest"
    }
  }
}
